# Service Configuration
SERVICE_NAME=SteamDNA ML Service
VERSION=1.0.0
DEBUG=true

# Database
# For Docker: use 'postgres' as host
# For local development: use 'localhost'
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=steamdna
DB_PASSWORD=steamdna_password
DB_DATABASE=steamdna

# CORS
# Use comma-separated values for multiple origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ML Settings - Feature Extraction
MIN_GAMES_FOR_ANALYSIS=5
FEATURE_VECTOR_SIZE=27
DEEP_DIVE_THRESHOLD_HOURS=100
HEAVY_PLAY_THRESHOLD_MINUTES=3000
NEW_RELEASE_WINDOW_DAYS=365

# ML Settings - Clustering
CLUSTERING_N_CLUSTERS=5
CLUSTERING_RANDOM_STATE=42
CLUSTERING_N_INIT=10

# ML Settings - Monitoring
MONITOR_MAX_SAMPLES=10000
LOW_CONFIDENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
